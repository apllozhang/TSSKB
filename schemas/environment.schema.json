{
  "$defs": {
    "DeployConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "remote_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Root"
        },
        "public_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Url"
        },
        "known_hosts": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Hosts"
        },
        "keep_releases": {
          "default": 5,
          "maximum": 50,
          "minimum": 2,
          "title": "Keep Releases",
          "type": "integer"
        }
      },
      "title": "DeployConfig",
      "type": "object"
    },
    "SearchBudget": {
      "additionalProperties": false,
      "properties": {
        "total_raw_bytes": {
          "minimum": 100000,
          "title": "Total Raw Bytes",
          "type": "integer"
        },
        "total_gzip_bytes": {
          "minimum": 50000,
          "title": "Total Gzip Bytes",
          "type": "integer"
        },
        "max_shard_raw_bytes": {
          "minimum": 50000,
          "title": "Max Shard Raw Bytes",
          "type": "integer"
        },
        "max_shard_gzip_bytes": {
          "minimum": 20000,
          "title": "Max Shard Gzip Bytes",
          "type": "integer"
        }
      },
      "required": [
        "total_raw_bytes",
        "total_gzip_bytes",
        "max_shard_raw_bytes",
        "max_shard_gzip_bytes"
      ],
      "title": "SearchBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "name": {
      "enum": [
        "dev",
        "staging",
        "prod"
      ],
      "title": "Name",
      "type": "string"
    },
    "strict": {
      "default": true,
      "title": "Strict",
      "type": "boolean"
    },
    "base_url": {
      "default": "/",
      "title": "Base Url",
      "type": "string"
    },
    "search_budget": {
      "$ref": "#/$defs/SearchBudget"
    },
    "deploy": {
      "$ref": "#/$defs/DeployConfig"
    }
  },
  "required": [
    "schema_version",
    "name",
    "search_budget",
    "deploy"
  ],
  "title": "EnvironmentConfig",
  "type": "object"
}
